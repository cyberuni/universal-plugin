{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter universal-plugin dev",
		"format": "biome format --write .",
		"plugin:build": "pnpm -C packages/universal-plugin exec tsx src/cli.ts plugin build --root . && pnpm check",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"up": "pnpm --filter ./packages/universal-plugin",
		"verify": "turbo verify",
		"version": "changeset version && pnpm -C packages/universal-plugin exec tsx src/cli.ts publish sync-version --no-build --root . && pnpm plugin:build",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16"
	},
	"packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539",
	"engines": {
		"node": ">=22"
	}
}
