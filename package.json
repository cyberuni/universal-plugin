{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter universal-plugin dev",
		"format": "biome format --write .",
		"plugin:build": "pnpm -C packages/universal-plugin exec tsx src/cli.ts plugin build --root . && pnpm check",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"up": "pnpm --filter ./packages/universal-plugin",
		"verify": "turbo verify",
		"version": "changeset version && pnpm -C packages/universal-plugin exec tsx src/cli.ts publish sync-version --no-build --root . && pnpm plugin:build",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16"
	},
	"packageManager": "pnpm@12.11.1+sha512.5b0e3288239a7ea4155d2094f547066e122a1376b3cd785a680c9112e116913e64aaaecf20dd83cc34030fa67013f5c5511f9cf430dd8384188b4c60b8a2ad1e",
	"engines": {
		"node": ">=22"
	}
}
