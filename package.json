{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter universal-plugin dev",
		"format": "biome format --write .",
		"plugin:build": "pnpm -C packages/universal-plugin exec tsx src/cli.ts plugin build --root . && pnpm check",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"up": "pnpm --filter ./packages/universal-plugin",
		"verify": "turbo verify",
		"version": "changeset version && pnpm -C packages/universal-plugin exec tsx src/cli.ts publish sync-version --root . && pnpm plugin:build",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16"
	},
	"packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35",
	"engines": {
		"node": ">=22"
	}
}
