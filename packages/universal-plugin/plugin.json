{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "universal-plugin",
	"version": "0.23.0",
	"description": "Research and design toolkit for building universal AI coding agent plugins that work across Claude Code, Cursor, Codex, and GitHub Copilot CLI.",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/universal-plugin",
	"repository": "https://github.com/cyberuni/universal-plugin",
	"license": "MIT",
	"keywords": ["universal", "plugin", "agent", "cross-vendor"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"dependencies": [{ "name": "cyber-agentkit", "marketplace": "cyber-uni" }],
			"harnesses": {
				"claude-code": {},
				"cursor": {},
				"codex": {},
				"copilot-cli": {}
			},
			"scripts": {
				"skills/adopt-upx/scripts/rewrite-upx.mjs": "src/skill-scripts/rewrite-upx.ts",
				"skills/doctor-universal-plugin/scripts/doctor.mjs": "src/skill-scripts/doctor.ts",
				"skills/marketplace/scripts/install-docs.mjs": "src/skill-scripts/install-docs.ts",
				"skills/build-plugin/scripts/universal-plugin.mjs": { "forward": "universal-plugin" },
				"skills/doctor-universal-plugin/scripts/universal-plugin.mjs": { "forward": "universal-plugin" },
				"skills/init-universal-plugin/scripts/universal-plugin.mjs": { "forward": "universal-plugin" },
				"skills/marketplace/scripts/universal-plugin.mjs": { "forward": "universal-plugin" },
				"skills/publish-plugin/scripts/universal-plugin.mjs": { "forward": "universal-plugin" },
				"skills/remove-plugin/scripts/universal-plugin.mjs": { "forward": "universal-plugin" },
				"skills/version/scripts/universal-plugin.mjs": { "forward": "universal-plugin" }
			}
		}
	}
}
