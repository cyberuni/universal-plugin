{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "universal-plugin",
	"version": "0.16.3",
	"description": "Research and design toolkit for building universal AI coding agent plugins that work across Claude Code, Cursor, Codex, and GitHub Copilot CLI.",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/universal-plugin",
	"repository": "https://github.com/cyberuni/universal-plugin",
	"license": "MIT",
	"keywords": ["universal", "plugin", "agent", "cross-vendor"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"dependencies": ["cyber-agentkit"],
			"harnesses": {
				"claude-code": {},
				"cursor": {},
				"codex": {},
				"copilot-cli": {}
			},
			"scripts": {
				"skills/adopt-upx/scripts/rewrite-upx.mjs": "src/skill-scripts/rewrite-upx.ts",
				"skills/doctor-universal-plugin/scripts/doctor.mjs": "src/skill-scripts/doctor.ts",
				"skills/marketplace/scripts/install-docs.mjs": "src/skill-scripts/install-docs.ts",
				"skills/build-plugin/scripts/build.mjs": {
					"source": "src/skill-scripts/run-cli.ts",
					"command": "plugin build"
				},
				"skills/init-universal-plugin/scripts/init.mjs": {
					"source": "src/skill-scripts/run-cli.ts",
					"command": "plugin init"
				},
				"skills/version/scripts/version.mjs": {
					"source": "src/skill-scripts/run-cli.ts",
					"command": "plugin version"
				},
				"skills/marketplace/scripts/add.mjs": {
					"source": "src/skill-scripts/run-cli.ts",
					"command": "marketplace add"
				},
				"skills/marketplace/scripts/marketplace.mjs": {
					"source": "src/skill-scripts/run-cli.ts",
					"command": "marketplace init"
				},
				"skills/marketplace/scripts/validate.mjs": {
					"source": "src/skill-scripts/run-cli.ts",
					"command": "marketplace validate"
				}
			}
		}
	}
}
